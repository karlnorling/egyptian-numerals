{
  "name": "@egyptian-numerals/cli",
  "version": "0.0.0",
  "description": "Draw Egyptian hieroglyphic numerals from the command line: SVG, PNG, JPEG or WebP",
  "keywords": [
    "ancient-egypt",
    "cli",
    "egyptian",
    "egyptian-fractions",
    "egyptian-numerals",
    "hieroglyphic",
    "hieroglyphs",
    "number",
    "numerals",
    "png",
    "svg"
  ],
  "homepage": "https://karlnorling.github.io/egyptian-numerals/",
  "bugs": {
    "url": "https://github.com/karlnorling/egyptian-numerals/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlnorling/egyptian-numerals.git",
    "directory": "packages/@egyptian-numerals/cli"
  },
  "bin": {
    "egyptian": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@egyptian-numerals/core": "workspace:^",
    "@egyptian-numerals/raster": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
