{
  "name": "@egyptian-numerals/core",
  "version": "0.1.0",
  "description": "Render any number as Egyptian hieroglyphic numerals in SVG, with zero dependencies",
  "keywords": [
    "ancient-egypt",
    "egyptian",
    "egyptian-fractions",
    "egyptian-numerals",
    "hieroglyphic",
    "hieroglyphs",
    "number",
    "numerals",
    "svg"
  ],
  "homepage": "https://karlnorling.github.io/egyptian-numerals/",
  "bugs": {
    "url": "https://github.com/karlnorling/egyptian-numerals/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlnorling/egyptian-numerals.git",
    "directory": "packages/@egyptian-numerals/core"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
